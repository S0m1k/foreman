# --- database (docker-compose overrides this) ---
DATABASE_URL=sqlite:///./storage/foreman.db

# --- storage: local | s3 (MinIO) ---
STORAGE_BACKEND=local
STORAGE_DIR=./storage/files
#S3_ENDPOINT_URL=http://localhost:9000
#S3_ACCESS_KEY=foreman
#S3_SECRET_KEY=foreman-secret
#S3_BUCKET=foreman

# --- background jobs: inline (dev) | celery ---
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- vision model (any OpenAI-compatible endpoint: vLLM / Ollama / LM Studio) ---
# Leave VLM_BASE_URL empty to run with deterministic extraction only.
#VLM_BASE_URL=http://localhost:8001/v1
VLM_MODEL=qwen3-vl-8b-instruct
VLM_API_KEY=not-needed
PROMPT_VERSION=v1

# --- OCR: auto | paddle | tesseract | none ---
OCR_PROVIDER=auto

# --- frontend origin allowed by CORS ---
CORS_ORIGINS=http://localhost:3000
